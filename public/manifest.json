{
  "manifest_version": 3,
  "name": "Logbook",
  "version": "0.2.0",
  "description": "Tracks time per website: visits, total time, and average time per session.",
  "permissions": ["tabs", "storage", "idle", "alarms", "notifications"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Logbook"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
